# Mobile Application Environment Variables Template

# Public Configuration (Safe to bundle in mobile clients)
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_API_BASE_URL=https://mplads-ai.vercel.app

# NOTE:
# Do NOT place private API keys (Groq, ElevenLabs, Database URLs, JWT secrets) in this file.
